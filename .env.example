# Taqeemak backend origin (no trailing slash). Server-side only: the site proxies /api/v1/* to it,
# so the browser never calls the backend directly (no CORS, first-party auth cookies).
API_BASE_URL=https://api.example.com

# Optional: Samsung Pay merchant service ID (from Moyasar / Samsung Pay onboarding). Samsung Pay stays hidden when empty.
NEXT_PUBLIC_MOYASAR_SAMSUNG_PAY_SERVICE_ID=
